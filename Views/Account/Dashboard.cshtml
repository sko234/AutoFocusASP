@model DashboardViewModel
@{
    string FormatDate(DateTime utc)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.Local);
        string[] months = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        return $"{months[local.Month - 1]} {local.Day:00}, {local.Year} {local.Hour:00}:{local.Minute:00}";
    }
}

<section style="min-height: 100vh; padding: 8rem 5% 4rem;">
    <div style="max-width: 900px; margin: 0 auto;">
        <div style="margin-bottom: 3rem; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 2rem;">
            <h1 style="font-family: var(--font-heading); font-size: 2.5rem; text-transform: uppercase; letter-spacing: 5px; margin-bottom: 0.5rem;" data-en="Dashboard" data-bg="Табло">Dashboard</h1>
            <p style="color: var(--color-silver); font-size: 1rem;">
                <span data-en="Welcome back," data-bg="Добре дошъл отново,">Welcome back,</span>
                <span style="color: #ffffff; font-weight: 600;">@Model.DisplayName</span>
            </p>
            <p style="color: var(--color-silver); font-size: 0.85rem; margin-top: 0.3rem;">@Model.Email</p>
        </div>

        <div>
            <h2 style="font-family: var(--font-heading); font-size: 1.5rem; text-transform: uppercase; letter-spacing: 3px; margin-bottom: 1.5rem;" data-en="My Comments" data-bg="Моите коментари">My Comments</h2>

            @if (Model.Comments.Count == 0)
            {
                <div style="text-align: center; padding: 3rem; border: 1px solid rgba(255,255,255,0.1); border-radius: 2px;">
                    <p style="color: var(--color-silver); font-size: 1rem; margin-bottom: 1rem;" data-en="You haven't posted any comments yet." data-bg="Все още нямате публикувани коментари.">You haven't posted any comments yet.</p>
                    <a href="/#models" style="display: inline-block; background: #ffffff; color: #000000; text-decoration: none; padding: 0.7rem 1.5rem; font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 2px; text-transform: uppercase;" data-en="BROWSE CARS" data-bg="РАЗГЛЕДАЙ АВТОМОБИЛИТЕ">BROWSE CARS</a>
                </div>
            }
            else
            {
                <div style="display: flex; flex-direction: column; gap: 1rem;">
                    @foreach (var comment in Model.Comments)
                    {
                        <div style="background: rgba(20, 20, 20, 1); border: 1px solid rgba(255,255,255,0.1); padding: 1.2rem 1.5rem; border-radius: 2px; display: flex; justify-content: space-between; align-items: flex-start; gap: 1rem;">
                            <div style="flex: 1;">
                                <div style="display: flex; align-items: center; gap: 1rem; margin-bottom: 0.5rem;">
                                    <a href="/car/@comment.CarSlug" style="color: #ffffff; font-family: var(--font-heading); font-size: 0.85rem; letter-spacing: 1px; text-transform: uppercase; text-decoration: none;">@comment.CarName</a>
                                    <span style="color: var(--color-silver); font-size: 0.75rem;">@FormatDate(comment.CreatedAt)</span>
                                </div>
                                <p style="color: var(--color-text); font-size: 0.95rem; line-height: 1.5; white-space: pre-line;">@comment.Text</p>
                            </div>
                            <form asp-controller="Home" asp-action="DeleteComment" asp-route-slug="@comment.CarSlug" asp-route-id="@comment.Id" method="post" style="flex: 0 0 auto;">
                                <button type="submit" style="background: transparent; border: 1px solid rgba(255,255,255,0.2); color: var(--color-silver); padding: 0.4rem 0.8rem; font-size: 0.75rem; cursor: pointer; text-transform: uppercase; letter-spacing: 1px; font-family: var(--font-heading);">DELETE</button>
                            </form>
                        </div>
                    }
                </div>
            }
        </div>

        <div style="margin-top: 3rem; text-align: center;">
            <a href="/" style="color: var(--color-silver); text-decoration: none; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 2px; font-family: var(--font-heading);" data-en="&larr; BACK TO SITE" data-bg="&larr; ОБРАТНО КЪМ САЙТА">&larr; BACK TO SITE</a>
        </div>
    </div>
</section>
