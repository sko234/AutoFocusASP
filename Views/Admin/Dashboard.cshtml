@model AdminDashboardViewModel
@{
    ViewBag.IsHome = false;

    string FormatDate(DateTime utc)
    {
        var local = TimeZoneInfo.ConvertTimeFromUtc(DateTime.SpecifyKind(utc, DateTimeKind.Utc), TimeZoneInfo.Local);
        string[] months = { "Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "Oct", "Nov", "Dec" };
        return $"{months[local.Month - 1]} {local.Day:00}, {local.Year} {local.Hour:00}:{local.Minute:00}";
    }
}

<section class="admin-page">
    <div class="admin-wrap">
        <section class="admin-section">
            <h1 class="admin-title" data-en="User Accounts" data-bg="Потребителски акаунти">User Accounts</h1>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th data-en="User name" data-bg="Потребител">User name</th>
                        <th data-en="Email" data-bg="Имейл">Email</th>
                        <th class="num" data-en="Images liked" data-bg="Харесани снимки">Images liked</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Users.Count == 0)
                    {
                        <tr>
                            <td colspan="3" class="admin-empty" data-en="No registered users yet." data-bg="Все още няма регистрирани потребители.">No registered users yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var user in Model.Users)
                        {
                            <tr>
                                @if (user.IsAdmin)
                                {
                                    <td colspan="3">admin</td>
                                }
                                else
                                {
                                    <td>@user.UserName</td>
                                    <td>@user.Email</td>
                                    <td class="num">@user.ImagesLiked</td>
                                }
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="admin-section">
            <h2 class="admin-title" data-en="Comments" data-bg="Коментари">Comments</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th data-en="Comment" data-bg="Коментар">Comment</th>
                        <th data-en="User" data-bg="Потребител">User</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Comments.Count == 0)
                    {
                        <tr>
                            <td colspan="2" class="admin-empty" data-en="No comments yet." data-bg="Все още няма коментари.">No comments yet.</td>
                        </tr>
                    }
                    else
                    {
                        foreach (var comment in Model.Comments)
                        {
                            <tr>
                                <td>
                                    <a class="admin-comment-link" href="@($"/car/{comment.CarSlug}#comment-{comment.Id}")">
                                        <span class="admin-comment-car">@comment.CarName</span>
                                        <span class="admin-comment-date">@FormatDate(comment.CreatedAt)</span>
                                        <p class="admin-comment-text">@comment.Text</p>
                                    </a>
                                    <form asp-controller="Home" asp-action="DeleteComment" asp-route-slug="@comment.CarSlug" asp-route-id="@comment.Id" asp-route-returnUrl="/admin" method="post">
                                        <button type="submit" class="admin-delete-button">DELETE</button>
                                    </form>
                                </td>
                                <td>@comment.UserName</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </section>

        <section class="admin-section">
            <h2 class="admin-title" data-en="Car Likes" data-bg="Харесвания на автомобили">Car Likes</h2>
            <table class="admin-table">
                <thead>
                    <tr>
                        <th data-en="Car" data-bg="Автомобил">Car</th>
                        <th class="num" data-en="Likes" data-bg="Харесвания">Likes</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var car in Model.CarLikes)
                    {
                        <tr>
                            <td>@car.CarName</td>
                            <td class="num">@car.Likes</td>
                        </tr>
                    }
                </tbody>
            </table>
        </section>
    </div>
</section>
