@model LoginViewModel
@{
    ViewBag.IsHome = false;
}

<section style="min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 6rem 2rem 2rem;">
    <div style="width: 100%; max-width: 420px;">
        <h1 style="font-family: var(--font-heading); font-size: 2.5rem; text-transform: uppercase; letter-spacing: 5px; text-align: center; margin-bottom: 0.5rem;" data-en="Admin Login" data-bg="Вход за админ">Admin Login</h1>
        <p style="text-align: center; color: var(--color-silver); font-size: 0.9rem; margin-bottom: 2rem;" data-en="Sign in to the admin area" data-bg="Влезте в админ панела">Sign in to the admin area</p>

        <form asp-controller="Admin" asp-action="Login" method="post">
            @if (!ViewData.ModelState.IsValid)
            {
                <div style="background: rgba(255, 255, 255, 0.1); border: 1px solid #ffffff; padding: 0.8rem; margin-bottom: 1.5rem; border-radius: 2px;">
                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                    {
                        <p style="color: #ffffff; font-size: 0.85rem; margin: 0.2rem 0;">@error.ErrorMessage</p>
                    }
                </div>
            }

            <div style="margin-bottom: 1.2rem;">
                <label asp-for="Email" style="display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.4rem; color: var(--color-silver);" data-en="EMAIL" data-bg="ИМЕЙЛ">EMAIL</label>
                <input asp-for="Email" type="email" required autocomplete="username" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); color: var(--color-text); padding: 0.8rem; font-family: var(--font-main); font-size: 1rem;" />
            </div>
            <div style="margin-bottom: 1.5rem;">
                <label asp-for="Password" style="display: block; font-family: var(--font-heading); font-size: 0.8rem; letter-spacing: 2px; text-transform: uppercase; margin-bottom: 0.4rem; color: var(--color-silver);" data-en="PASSWORD" data-bg="ПАРОЛА">PASSWORD</label>
                <input asp-for="Password" type="password" required autocomplete="current-password" style="width: 100%; background: rgba(255,255,255,0.05); border: 1px solid rgba(255,255,255,0.2); color: var(--color-text); padding: 0.8rem; font-family: var(--font-main); font-size: 1rem;" />
            </div>
            <button type="submit" style="width: 100%; background: #ffffff; color: #050505; border: none; padding: 1rem; font-family: var(--font-heading); font-size: 1rem; letter-spacing: 3px; text-transform: uppercase; cursor: pointer;" data-en="LOGIN" data-bg="ВХОД">LOGIN</button>
        </form>

        <p style="text-align: center; margin-top: 1.5rem;">
            <a href="/" style="color: var(--color-silver); text-decoration: none; font-size: 0.8rem; text-transform: uppercase; letter-spacing: 1px;" data-en="&larr; Back to site" data-bg="&larr; Обратно към сайта">&larr; Back to site</a>
        </p>
    </div>
</section>
